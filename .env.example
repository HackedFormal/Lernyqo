# Lernyqo AI configuration
# Start with Demo Mode. It works without any API key.
DEMO_MODE=true

# Optional free Gemini API key.
# Get one from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Local app settings
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_UPLOAD_MB=15
MAX_AI_CHARS=24000
